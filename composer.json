{
    "name": "microscrap/posix",
    "description": "Unix POSIX Bindings for The PHP Posi Extension",
    "type": "library",
    "version": "0.8.0",
    "keywords": [
        "framework",
        "scrapyard-io",
        "posix",
        "posi",
        "bindings"
    ],
    "license": "MIT",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/microscrap/posix/0.7.x/overview",
    "support": {
        "docs": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/microscrap/posix/0.7.x/overview",
        "source": "https://github.com/microscrap/posix",
        "issues": "https://github.com/microscrap/posix/issues"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "ext-posi": "^0.8.0"
    },
    "suggest": {
        "microscrap/uart": "^0.8.0 - UART / serial bindings over posix + ext-posi",
        "microscrap/gpio": "^0.8.0 - gpiod bindings over posix + ext-posi",
        "microscrap/i2c": "^0.8.0 - libi2c bindings over posix + ext-posi",
        "microscrap/spi": "^0.8.0 - spidev bindings over posix + ext-posi",
        "scrapyard-io/gpio-framework": "GPIO application framework over Microscrap protocol bindings (^0.7)"
    },
    "autoload": {
        "psr-4": {
            "Microscrap\\Bindings\\POSIX\\": "src/"
        },
        "files": [
            "src/Helpers/posix-system.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.8.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
