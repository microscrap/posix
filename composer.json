{
    "name": "microscrap/posix",
    "description": "Unix POSIX Bindings for The PHP Posi Extension",
    "type": "library",
    "version": "0.9.0",
    "keywords": [
        "framework",
        "scrapyard-io",
        "posix",
        "posi",
        "bindings"
    ],
    "license": "MIT",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/microscrap/posix/0.7.x/overview",
    "support": {
        "docs": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/microscrap/posix/0.7.x/overview",
        "source": "https://github.com/microscrap/posix",
        "issues": "https://github.com/microscrap/posix/issues"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "ext-posi": "^0.9.0"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "suggest": {
        "microscrap/uart": "^0.9.0 - UART / serial bindings over posix + ext-posi",
        "microscrap/gpio": "^0.9.0 - gpiod bindings over posix + ext-posi",
        "microscrap/i2c": "^0.9.0 - libi2c bindings over posix + ext-posi",
        "microscrap/spi": "^0.9.0 - spidev bindings over posix + ext-posi",
        "scrapyard-io/framework": "^0.9.0 - GPIO application framework over Microscrap protocol bindings"
    },
    "autoload": {
        "psr-4": {
            "Microscrap\\Bindings\\POSIX\\": "src/"
        },
        "files": [
            "src/Helpers/posix-system.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Microscrap\\Bindings\\POSIX\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.9.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
