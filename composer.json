{
    "name": "microscrap/posix",
    "description": "Unix POSIX Bindings for The PHP Posi Extension",
    "type": "library",
    "version": "0.5.1",
    "keywords": ["framework", "scrapyard-io"],
    "license": "MIT",
    "homepage": "https://dosr.projectsaturnstudios.com",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-posi": "^0.4.11|^0.5.0"
    },
    "autoload": {
        "psr-4": {
            "Microscrap\\Bindings\\POSIX\\": "src/"
        },
        "files": [
            "src/Helpers/posix-system.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
